{
  "name": "@simplishelf/sheet-ingest",
  "version": "0.1.9",
  "description": "A configurable React spreadsheet import flow for CSV and Excel files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahushr/SheetIngest.git"
  },
  "homepage": "https://github.com/nahushr/SheetIngest#readme",
  "bugs": {
    "url": "https://github.com/nahushr/SheetIngest/issues"
  },
  "keywords": [
    "react",
    "spreadsheet",
    "excel",
    "xlsx",
    "csv",
    "import",
    "data-import"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "prepack": "npm run build",
    "typecheck:example": "tsc --noEmit -p examples/vite/tsconfig.json",
    "build:example": "npm run typecheck:example && npm run build --workspace sheet-ingest-vite-example",
    "dev:example": "npm run build && npm run dev --workspace sheet-ingest-vite-example"
  },
  "workspaces": [
    "examples/vite"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^8.17.0",
    "@simplishelf/super-data-grid": "^0.2.1 || ^0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^9.39.5",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^8.17.0",
    "@simplishelf/super-data-grid": "^0.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/node": "^22.19.15",
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
